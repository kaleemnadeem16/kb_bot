# Leave OPENAI_API_KEY unset to run in offline mode (keyword retrieval, no LLM).
OPENAI_API_KEY=

# Optional overrides (defaults shown)
# OPENAI_MODEL=gpt-4.1-nano
# EMBEDDING_MODEL=text-embedding-3-small
# CHUNK_SIZE=500
# CHUNK_OVERLAP=50
# TOP_K=4
# MIN_SCORE=0.0   # ignore passages with cosine similarity below this
# TEMPERATURE=0.1
# DATA_DIR=data
# INDEX_DIR=vector_store
